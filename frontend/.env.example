# API URL - backend server
# Local: http://localhost:5000/api
# Production: https://your-backend.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Backend base URL (without /api) - for image uploads, etc.
VITE_BACKEND_URL=http://localhost:5000

# Google OAuth
VITE_GOOGLE_CLIENT_ID=

# WalletConnect
VITE_WALLETCONNECT_PROJECT_ID=

# Smart Contract Addresses (Polygon Amoy Testnet)
VITE_CHAIN_ID=80002
VITE_ESCROW_ADDRESS=
VITE_USDT_ADDRESS=
VITE_POLYGON_RPC=https://polygon-rpc.com
VITE_POLYGON_AMOY_RPC=https://polygon-amoy-bor-rpc.publicnode.com
VITE_POLYGON_MAINNET_CHAIN_ID=137
VITE_USDT_MAINNET_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
VITE_BLOCK_EXPLORER=https://amoy.polygonscan.com
VITE_PLATFORM_WALLET=

# Deposit System
VITE_SOLANA_DEPOSIT_ADDRESS=

# MoonPay fiat on-ramp
VITE_MOONPAY_API_KEY=
VITE_MOONPAY_ENV=sandbox
VITE_MOONPAY_DEFAULT_CURRENCY=usdc_polygon

# Feature flags
VITE_ENABLE_TESTNETS=true
